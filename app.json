{
  "expo": {
    "name": "Tably",
    "description": "Save it. Plan it. Shop for it.",
    "slug": "mealmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tably-icon.png",
    "scheme": "mealmate",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/tably.icon",
      "usesAppleSignIn": true,
      "bundleIdentifier": "nl.mealmate.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#195C44",
        "foregroundImage": "./assets/images/tably-android-icon.png",
        "monochromeImage": "./assets/images/tably-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/tably-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAF9"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tably gebruikt je foto's om gerechten en recepten toe te voegen.",
          "cameraPermission": "Tably gebruikt de camera om gerechten en recepten te fotograferen.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": false
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "14052397-d4de-417e-9c10-38b68678f3ba"
      }
    },
    "owner": "jasperhuting",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/14052397-d4de-417e-9c10-38b68678f3ba"
    }
  }
}
